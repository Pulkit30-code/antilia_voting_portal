# Browser-safe project endpoint and publishable API key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never add NEXT_PUBLIC_ to either value.
SUPABASE_SECRET_KEY=sb_secret_replace_me
ANTILIA_RATE_LIMIT_PEPPER=generate_at_least_32_random_bytes

# One-time bootstrap only. Set locally, run the bootstrap, then delete both.
ANTILIA_BOOTSTRAP_HR_PASSCODE=
ANTILIA_BOOTSTRAP_SYSTEM_PASSCODE=
